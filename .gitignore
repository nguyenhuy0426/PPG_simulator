# Recordings written by the app (dataset/data_N.csv) and downloaded datasets.
dataset/

# Virtual environments.
# A venv must never be committed: its wheels are architecture-specific (the
# laptop is x86_64, the Raspberry Pi 4 is aarch64) and the shebangs in .venv/bin
# hardcode absolute paths. Each machine recreates its own with
# scripts/setup_laptop_venv.sh or scripts/setup_rpi_ubuntu.sh.
.venv/
.venv-ml/
venv/
env/

# Research outputs. Kaggle runs stay local; only the generators the app loads
# are committed.
ml/runs/
assets/neural/*.ts
!assets/neural/lsm_generator.ts
!assets/neural/physiomix_generator.ts
!assets/neural/physioflow_generator.ts

# Python bytecode / build artefacts
docs/paper/*.log
docs/paper/*.blg
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# PlatformIO / editor / tooling caches
.pio/
.codegraph/
.codebase-memory/
.pytest_cache/
.ruff_cache/
.kilo/

# CAD virtual environment (trimesh/manifold3d — 190 MB, tạo lại bằng pip)
.cad_venv/

# KiCad local UI state, locks and embedded edit history.
.history/
*.kicad_prl
*.lck
*-backups/

# Local configuration and credentials. Commit only the documented template.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
kaggle.json
.claude/

# Local model weights above the 100 MB GitHub limit and bulky run outputs; keep on disk, never commit.
assets/apft/generator.pt
runs/
