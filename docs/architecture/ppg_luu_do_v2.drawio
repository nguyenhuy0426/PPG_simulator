xitDx=0;exitDy=0;entryX=0.9927;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="P2" target="J4"><mxGeometry x="-0.885" relative="1" as="geometry"><Array as="points"><mxPoint x="2544" y="2650"/><mxPoint x="2544" y="2904"/></Array></mxGeometry></mxCell><mxCell id="W7" value="Ghi nốt D5; đóng file,&lt;br&gt;đổi tên thành&lt;br&gt;dataset/&amp;lt;tên&amp;gt;.csv" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1748" y="2942" width="220" height="68" as="geometry"/></mxCell><mxCell id="W8" value="Trả về" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1763" y="3038" width="190" height="46" as="geometry"/></mxCell><mxCell id="e227" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;labelBackgroundColor=default;fontSize=11;exitX=0.1582;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="J4" target="W7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e228" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;labelBackgroundColor=default;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="W7" target="W8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sub_title" value="&lt;b style='font-size:18px'&gt;Các chương trình con&lt;/b&gt; (khối ‘chương trình con’ ở phần trên trỏ tới các lưu đồ này; chúng chạy trên luồng của nơi gọi, trừ các luồng mới tạo ở thanh rẽ luồng)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="2076" width="1800" height="40" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2654" y="2172" width="110" height="44" as="geometry"/></mxCell><mxCell id="lt0" value="Đầu / cuối" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2184" width="420" height="24" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2654" y="2228" width="110" height="44" as="geometry"/></mxCell><mxCell id="lt1" value="Xử lý" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2240" width="420" height="24" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2654" y="2284" width="110" height="56" as="geometry"/></mxCell><mxCell id="lt2" value="Quyết định: nhánh Đúng / Sai" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2302" width="420" height="24" as="geometry"/></mxCell><mxCell id="lg3" value="" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2654" y="2352" width="110" height="44" as="geometry"/></mxCell><mxCell id="lt3" value="Vào / ra dữ liệu: I2C, mạng, tệp" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2364" width="420" height="24" as="geometry"/></mxCell><mxCell id="lg4" value="" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2654" y="2408" width="110" height="44" as="geometry"/></mxCell><mxCell id="lt4" value="Chương trình con (lưu đồ riêng ở dưới)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2420" width="420" height="24" as="geometry"/></mxCell><mxCell id="lg5" value="" style="shape=internalStorage;whiteSpace=wrap;html=1;backgroundOutline=1;dx=10;dy=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacingLeft=8;spacingTop=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2654" y="2464" width="110" height="44" as="geometry"/></mxCell><mxCell id="lt5" value="Bộ nhớ trong dùng chung giữa các luồng" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2476" width="420" height="24" as="geometry"/></mxCell><mxCell id="lg6" value="" style="shape=dataStorage;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2654" y="2520" width="110" height="44" as="geometry"/></mxCell><mxCell id="lt6" value="Dữ liệu lưu trữ (tệp trên thẻ nhớ)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2532" width="420" height="24" as="geometry"/></mxCell><mxCell id="lg7" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2654" y="2576" width="110" height="44" as="geometry"/></mxCell><mxCell id="lt7" value="Cơ sở dữ liệu" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2588" width="420" height="24" as="geometry"/></mxCell><mxCell id="lgbar" value="" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=none;strokeWidth=2;verticalAlign=bottom;labelPosition=center;verticalLabelPosition=top;align=right;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="2654" y="2642" width="110" height="8" as="geometry"/></mxCell><mxCell id="ltbar" value="Song song: rẽ luồng (fork) / hợp luồng (join)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2632" width="420" height="40" as="geometry"/></mxCell><mxCell id="lge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;labelBackgroundColor=default;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2654" y="2692" as="sourcePoint"/><mxPoint x="2764" y="2692" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lte0" value="Luồng điều khiển" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2682" width="420" height="24" as="geometry"/></mxCell><mxCell id="lge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=9;dashed=1;dashPattern=10 5;strokeWidth=1.6;strokeColor=#1f78b4;fontColor=#1f78b4;jumpStyle=arc;jumpSize=8;labelBackgroundColor=default;fontSize=11;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2654" y="2726" as="sourcePoint"/><mxPoint x="2764" y="2726" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lte1" value="Truyền thông qua mạng (MQTT, HTTP, BLE)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2716" width="420" height="24" as="geometry"/></mxCell><mxCell id="lge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;dashPattern=2 3;strokeColor=#7f7f7f;fontColor=#7f7f7f;jumpStyle=arc;labelBackgroundColor=default;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2654" y="2760" as="sourcePoint"/><mxPoint x="2764" y="2760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lte2" value="Truy cập dữ liệu dùng chung (đọc / ghi / lấy)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2784" y="2750" width="420" height="24" as="geometry"/></mxCell><mxCell id="shared" value="&lt;b&gt;D1&lt;/b&gt; Bộ đệm RX: luồng thu tín hiệu ghi; luồng chính đọc.&lt;br&gt;&lt;b&gt;D2&lt;/b&gt; Hàng đợi giữa link BLE/MQTT và luồng chính: yêu cầu trang, phát lại (link → luồng chính); mẫu stream, trạng thái trang (luồng chính → link).&lt;br&gt;&lt;b&gt;D3&lt;/b&gt; Tham số và trạng thái engine: handle_command và giao diện ghi; SignalGen, luồng MQTT gửi, luồng BLE đọc.&lt;br&gt;&lt;b&gt;D4&lt;/b&gt; Bộ đệm vòng TX (1024 mẫu): SignalGen ghi; SignalDAC lấy.&lt;br&gt;&lt;b&gt;D5&lt;/b&gt; Hàng đợi ghi CSV: SignalGen ghi; RecordPump lấy.&lt;br&gt;&lt;b&gt;D6&lt;/b&gt; dataset/*.csv trên thẻ nhớ: RecordPump ghi; luồng đồng bộ đọc.&lt;br&gt;&lt;b&gt;D7&lt;/b&gt; PostgreSQL: chỉ API đọc / ghi.&lt;br&gt;&lt;b&gt;D8&lt;/b&gt; Hàng đợi gửi của Paho trên điện thoại: luồng chính UI ghi; luồng mạng Paho lấy.&lt;br&gt;D1–D5 được bảo vệ bằng khóa (lock). D6: ghi vào tệp tạm rồi đổi tên; luồng đồng bộ bỏ qua tệp tạm và tệp vừa đổi chưa đủ 2 s. D7: giao dịch PostgreSQL (COMMIT). D8: hàng đợi nội bộ của Paho." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2648" y="2862" width="572" height="240" as="geometry"/></mxCell><mxCell id="notes" value="• Vẽ chế độ có giao diện. Chế độ --ble-only (không giao diện) không vẽ.&lt;br&gt;• Mỗi broker có một cặp luồng MQTT nhận / gửi riêng; hình vẽ một cặp.&lt;br&gt;• Luồng BLE chạy asyncio: các coroutine xen kẽ trong một luồng, không song song thật.&lt;br&gt;• Máy chủ (uvicorn) phục vụ nhiều yêu cầu cùng lúc; mỗi yêu cầu đi theo lưu đồ máy chủ.&lt;br&gt;• Paho Java trên điện thoại có các luồng nhận, gửi, callback riêng; gộp thành một làn.&lt;br&gt;• Broker là phần mềm có sẵn (Mosquitto / EMQX), chỉ vẽ ở mức hộp đen.&lt;br&gt;• Luồng phụ không vẽ: PulseTone (tiếng bíp theo nhịp), RxRespRate (tính RR), ghép đôi bằng mã QR, bật / tắt BLE, tiến trình sinh sóng của trang Model.&lt;br&gt;• Lưu đồ dựng từ mã nguồn hiện có, ở mức thiết kế; không phải kết quả đo trên phần cứng. Đầu ra là tín hiệu mô phỏng, không dùng cho chẩn đoán." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2648" y="3182" width="572" height="205" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:24px'&gt;Lưu đồ giải thuật hệ thống mô phỏng PPG (bản thiết kế, tinh gọn): Raspberry Pi 4 – MQTT – điện thoại Android – cơ sở dữ liệu&lt;/b&gt;&lt;br&gt;Ký hiệu theo ISO 5807. Mỗi làn dọc là một luồng; các luồng giữa thanh rẽ luồng và hợp luồng chạy song song. Phần dưới là các chương trình con, chú giải và ghi chú." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2600" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Tuần tự 1: MQTT"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L82" value="Người dùng" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=52;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=none;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="185" width="30" height="2404" as="geometry"/></mxCell><mxCell id="L83" value="App Android&lt;br&gt;(MqttLink, Paho)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#d5e8d4;strokeColor=#666666;fontColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="185" width="150" height="2404" as="geometry"/></mxCell><mxCell id="L84" value="Broker MQTT&lt;br&gt;(Mosquitto / EMQX)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#fff2cc;strokeColor=#666666;fontColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="185" width="150" height="2404" as="geometry"/></mxCell><mxCell id="L85" value="Pi: luồng MQTT nhận&lt;br&gt;(paho)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#dae8fc;strokeColor=#666666;fontColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="185" width="150" height="2404" as="geometry"/></mxCell><mxCell id="L86" value="Pi: luồng MQTT gửi&lt;br&gt;(mqtt-publish, 10 Hz)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#dae8fc;strokeColor=#666666;fontColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="185" width="150" height="2404" as="geometry"/></mxCell><mxCell id="L87" value="Pi: engine&lt;br&gt;(tham số, mô phỏng)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#dae8fc;strokeColor=#666666;fontColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="185" width="150" height="2404" as="geometry"/></mxCell><mxCell id="L88" value="Pi: luồng chính&lt;br&gt;(giao diện Tk)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=56;fillColor=#dae8fc;strokeColor=#666666;fontColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="185" width="150" height="2404" as="geometry"/></mxCell><mxCell id="c28" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fillColor=none;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="465" y="749" width="710" height="146" as="geometry"/></mxCell><mxCell id="c32" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fillColor=none;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1107" y="989" width="536" height="78" as="geometry"/></mxCell><mxCell id="m33" value="" style="endArrow=none;html=1;dashed=1;dashPattern=8 4;strokeColor=#666666;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="465" y="1087" as="sourcePoint"/><mxPoint x="1695" y="1087" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fillColor=none;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="477" y="1119" width="956" height="220" as="geometry"/></mxCell><mxCell id="c42" value="par" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fillColor=none;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="465" y="953" width="1230" height="406" as="geometry"/></mxCell><mxCell id="m51" value="" style="endArrow=none;html=1;dashed=1;dashPattern=8 4;strokeColor=#666666;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="885" y="1639" as="sourcePoint"/><mxPoint x="1675" y="1639" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fillColor=none;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1197" y="1753" width="426" height="86" as="geometry"/></mxCell><mxCell id="c60" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fillColor=none;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="885" y="1567" width="790" height="322" as="geometry"/></mxCell><mxCell id="m71" value="" style="endArrow=none;html=1;dashed=1;dashPattern=8 4;strokeColor=#666666;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="465" y="2227" as="sourcePoint"/><mxPoint x="1175" y="2227" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c75" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fillColor=none;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="465" y="2119" width="710" height="220" as="geometry"/></mxCell><mxCell id="c81" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=54;height=22;fillColor=none;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="255" y="2399" width="1130" height="146" as="geometry"/></mxCell><mxCell id="c37" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1369" y="1167" width="12" height="30" as="geometry"/></mxCell><mxCell id="c59" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1369" y="1683" width="12" height="190" as="geometry"/></mxCell><mxCell id="c63" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1369" y="1923" width="12" height="30" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b style='font-size:22px'&gt;Sơ đồ tuần tự 1: kết nối, giám sát và điều khiển qua MQTT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1810" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Dựng từ mã nguồn: Pi comm/mqtt_remote.py, comm/ble_server.py; Android remote/MqttLink.java. Topic ppgsim/&amp;lt;id&amp;gt;/…; hai broker (Tailscale, EMQX) hoạt động giống nhau nên vẽ một." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="50" width="1810" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Ký hiệu thông điệp&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="10" width="260" height="20" as="geometry"/></mxCell><mxCell id="m4" value="" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1560" y="40" as="sourcePoint"/><mxPoint x="1630" y="40" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="Gọi đồng bộ (chờ kết quả)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1642" y="31" width="300" height="20" as="geometry"/></mxCell><mxCell id="m6" value="" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1560" y="64" as="sourcePoint"/><mxPoint x="1630" y="64" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="Thông điệp không chờ (gói mạng, hàng đợi)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1642" y="55" width="300" height="20" as="geometry"/></mxCell><mxCell id="m8" value="" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;dashPattern=6 4;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1560" y="88" as="sourcePoint"/><mxPoint x="1630" y="88" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="Trả về / phản hồi" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1642" y="79" width="300" height="20" as="geometry"/></mxCell><mxCell id="c10" value="Thanh dọc trắng: đối tượng đang thực thi lời gọi. Khung alt / opt / loop / par: lựa chọn, tùy chọn, lặp, song song (UML 2)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="114" width="380" height="40" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;A. Pi kết nối broker&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="293" width="200" height="40" as="geometry"/></mxCell><mxCell id="m12" value='CONNECT (TLS, keepalive 30 s,&lt;br&gt;will: online = "0", retained)' style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="955" y="347" as="sourcePoint"/><mxPoint x="745" y="347" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13" value="CONNACK" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;dashPattern=6 4;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="745" y="377" as="sourcePoint"/><mxPoint x="955" y="377" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m14" value="SUBSCRIBE cmd (QoS 1), client (QoS 0)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="955" y="407" as="sourcePoint"/><mxPoint x="745" y="407" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15" value='PUBLISH online = "1" (QoS 1, retained)' style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="955" y="437" as="sourcePoint"/><mxPoint x="745" y="437" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m16" value="PUBLISH status (QoS 1, retained khi đổi,&lt;br&gt;tối đa 1 lần mỗi 1,1 s)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1165" y="481" as="sourcePoint"/><mxPoint x="745" y="481" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;B. App kết nối&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="507" width="200" height="40" as="geometry"/></mxCell><mxCell id="m18" value="Chọn kết nối Internet (MQTT)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="325" y="547" as="sourcePoint"/><mxPoint x="535" y="547" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m19" value="CONNECT (TLS, clean session;&lt;br&gt;thử Tailscale rồi EMQX)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="535" y="591" as="sou